ymmsl_version: v0.2

imports:
- from imas_muscle3 import implementation source_component
- from imas_muscle3 import implementation sink_component
- from imas_muscle3 import implementation recorder_component
- from imas_muscle3 import implementation olc_component
- from lib.easybuild_programs import implementation waveform_editor
- from lib.easybuild_programs import implementation load_balancer
- from lib.easybuild_programs import implementation nice_inv
- from lib.local_programs import implementation torax_coupled
- from lib.local_programs import implementation hcd_workflow
- from lib.local_programs import implementation torbeam
- from lib.local_programs import implementation hcd2core_sources

models:
  nice_inverse:
    description: NICE inverse solve, load-balanced over N workers
    ports:
      f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
      o_f: [equilibrium_out_f, pf_active_out_f]
    components:
      load_balancer:
        description: IMAS-aware NICE load balancer -- scatters slices, gathers results
        implementation: load_balancer
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_i: [equilibrium_scatter, wall_scatter, pf_active_scatter, pf_passive_scatter, iron_core_scatter]
          s: [equilibrium_gather, pf_active_gather]
          o_f: [equilibrium_out_f, pf_active_out_f]
      nice:
        description: NICE inverse worker
        implementation: nice_inv
        multiplicity: [1]
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out, pf_active_out]
      recorder_equilibrium:
        description: distill recorder (NICE inverse outputs)
        implementation: recorder_component
        ports: {s: [equilibrium_in, pf_active_in]}
    conduits:
      equilibrium_in: load_balancer.equilibrium_in
      wall_in: load_balancer.wall_in
      pf_active_in: load_balancer.pf_active_in
      pf_passive_in: load_balancer.pf_passive_in
      iron_core_in: load_balancer.iron_core_in

      load_balancer.equilibrium_scatter: nice.equilibrium_in
      load_balancer.wall_scatter: nice.wall_in
      load_balancer.pf_active_scatter: nice.pf_active_in
      load_balancer.pf_passive_scatter: nice.pf_passive_in
      load_balancer.iron_core_scatter: nice.iron_core_in

      nice.equilibrium_out: load_balancer.equilibrium_gather
      nice.pf_active_out: load_balancer.pf_active_gather

      load_balancer.equilibrium_out_f: [equilibrium_out_f, recorder_equilibrium.equilibrium_in]
      load_balancer.pf_active_out_f: [pf_active_out_f, recorder_equilibrium.pf_active_in]

  nice_torax_torbeam_modern:
    description: Modernized coupled NICE-TORAX-TORBEAM multi-physics workflow with waveform_editor
    components:
      source:
        description: Input source loader (seeds target equilibrium and core_profiles traces)
        implementation: source_component
        ports:
          o_i:
          - equilibrium_out
          - core_profiles_out

      waveform_editor:
        description: Waveform editor (pulse design targets + static machine description)
        implementation: waveform_editor
        ports:
          f_init:
          - equilibrium_in
          - core_profiles_in
          o_f:
          - equilibrium_out
          - core_sources_out
          - core_profiles_out
          - wall_out
          - pf_passive_out
          - iron_core_out
          - pf_active_out

      equilibrium:
        description: NICE inverse solve submodel (load-balanced over N workers)
        implementation: nice_inverse
        ports:
          f_init: [equilibrium_in, wall_in, pf_active_in, pf_passive_in, iron_core_in]
          o_f: [equilibrium_out_f, pf_active_out_f]

      torax:
        description: TORAX core transport solver
        implementation: torax_coupled
        ports:
          f_init:
          - equilibrium_in_f
          - core_profiles_in_f
          - core_sources_in_f
          o_i:
          - equilibrium_out_i
          - core_profiles_out_i
          s:
          - core_sources_in_s
          o_f:
          - equilibrium_out_f
          - core_profiles_out_f

      hcd_workflow:
        description: HCD workflow coordinator
        implementation: hcd_workflow
        ports:
          f_init:
          - equilibrium_f_init
          - core_profiles_f_init
          o_i:
          - equilibrium_out_i_4
          - core_profiles_out_i
          - ec_launchers_out_i
          - distributions_out_i
          - distribution_sources_out_i
          - waves_out_i
          s:
          - waves_in_s
          - core_sources_in_s
          o_f:
          - core_sources_out_f
          - ec_launchers_out_f

      torbeam:
        description: TORBEAM ray-tracing solver
        implementation: torbeam
        ports:
          f_init:
          - equilibrium_in
          - core_profiles_in
          - ec_launchers_in
          o_f:
          - waves_out

      hcd2core_sources:
        description: HCD to core sources converter
        implementation: hcd2core_sources
        ports:
          f_init:
          - core_profiles_in
          - waves_in
          - distributions_in
          - distribution_sources_in
          o_f:
          - core_sources_out

      validator:
        description: IMAS OLC rule validator
        implementation: olc_component
        optional: true
        ports:
          f_init:
          - pf_active_in

      sink_nice:
        description: Sink for NICE equilibrium outputs
        implementation: sink_component
        ports:
          f_init:
          - equilibrium_in
          - pf_active_in

      sink_torax:
        description: Sink for TORAX transport outputs
        implementation: sink_component
        ports:
          f_init:
          - equilibrium_in
          - core_profiles_in

      sink_hcd:
        description: Sink for HCD wave and source outputs
        implementation: sink_component
        ports:
          f_init:
          - equilibrium_in
          - core_profiles_in
          - waves_in
          - core_sources_in
          - ec_launchers_in

      sink_oi_hcd:
        description: Intermediate sink for HCD inter-actor data
        implementation: sink_component
        ports:
          f_init:
          - equilibrium_in
          - core_profiles_in
          - ec_launchers_in
          - waves_in
          - distributions_in
          - distribution_sources_in

    conduits:
      source.equilibrium_out: waveform_editor.equilibrium_in
      source.core_profiles_out: waveform_editor.core_profiles_in

      waveform_editor.equilibrium_out: equilibrium.equilibrium_in
      waveform_editor.wall_out: equilibrium.wall_in
      waveform_editor.pf_passive_out: equilibrium.pf_passive_in
      waveform_editor.iron_core_out: equilibrium.iron_core_in
      waveform_editor.pf_active_out: equilibrium.pf_active_in
      waveform_editor.core_profiles_out: torax.core_profiles_in_f
      waveform_editor.core_sources_out: torax.core_sources_in_f

      equilibrium.equilibrium_out_f:
      - torax.equilibrium_in_f
      - sink_nice.equilibrium_in
      equilibrium.pf_active_out_f:
      - sink_nice.pf_active_in
      - validator.pf_active_in

      torax.equilibrium_out_f: sink_torax.equilibrium_in
      torax.core_profiles_out_f: sink_torax.core_profiles_in

      torax.equilibrium_out_i:
      - hcd_workflow.equilibrium_f_init
      - sink_hcd.equilibrium_in
      torax.core_profiles_out_i:
      - hcd_workflow.core_profiles_f_init
      - sink_hcd.core_profiles_in

      hcd_workflow.equilibrium_out_i_4:
      - torbeam.equilibrium_in
      - sink_oi_hcd.equilibrium_in
      hcd_workflow.core_profiles_out_i:
      - torbeam.core_profiles_in
      - hcd2core_sources.core_profiles_in
      - sink_oi_hcd.core_profiles_in
      hcd_workflow.ec_launchers_out_i:
      - torbeam.ec_launchers_in
      - sink_oi_hcd.ec_launchers_in
      hcd_workflow.distributions_out_i:
      - hcd2core_sources.distributions_in
      - sink_oi_hcd.distributions_in
      hcd_workflow.distribution_sources_out_i:
      - hcd2core_sources.distribution_sources_in
      - sink_oi_hcd.distribution_sources_in
      hcd_workflow.waves_out_i:
      - hcd2core_sources.waves_in
      - sink_oi_hcd.waves_in

      torbeam.waves_out:
      - hcd_workflow.waves_in_s
      - sink_hcd.waves_in

      hcd2core_sources.core_sources_out:
      - hcd_workflow.core_sources_in_s
      - sink_hcd.core_sources_in

      hcd_workflow.core_sources_out_f: torax.core_sources_in_s
      hcd_workflow.ec_launchers_out_f: sink_hcd.ec_launchers_in
